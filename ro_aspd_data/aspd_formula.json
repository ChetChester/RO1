{
  "source": "https://ro.dvg.cn/tools/rocal/js/cal.js (AspdCal function)",
  "calculation_steps": {
    "step1_stat_bonus": {
      "description": "素質攻速加成，依武器類型分兩種公式",
      "general": "StatBonus = sqrt(AGI * 1120/111 + DEX * 11/60)",
      "bow_type": "StatBonus = sqrt(AGI * (10 - 1/400) + DEX * 11/60)",
      "note": "若根號內為負值，取絕對值後開根號再加負號（AGI/DEX極低時）"
    },
    "step2_base_temp": {
      "description": "依武器/盾牌/雙持計算基礎值",
      "general_low_speed": {
        "condition": "武器基礎值 < 145",
        "formula": "BaseTemp = WeaponValue + StatBonus + ShieldValue"
      },
      "general_high_speed": {
        "condition": "武器基礎值 >= 145",
        "formula": "BaseTemp = WeaponValue + StatBonus * (1 - (WeaponValue - 144) / 50) + ShieldValue",
        "note": "攻速越高的武器，素質加成越少（邊際效應）"
      },
      "dual_wield": {
        "condition": "左手值 > 0（雙持）",
        "formula": "BaseTemp = RightHand + (LeftHand - 194) / 4 + StatBonus * 1.04518",
        "note": "雙持不套用盾牌值"
      }
    },
    "step3_skill_potion": {
      "description": "技能/藥水百分比加成（乘法疊加）",
      "formula": "AfterSkill = 200 - (200 - BaseTemp) * (100 - SkillPotionPercent) / 100",
      "rune_knight": {
        "condition": "盧恩騎士且啟用Asir盧恩石",
        "formula": "AfterSkill += RuneLevel * 0.4"
      }
    },
    "step4_equipment": {
      "description": "裝備攻速百分比加成",
      "formula": "AfterEquip = 200 - (200 - AfterSkill) * (100 - EquipPercent) / 100",
      "equip_percent_sources": [
        "裝備ASPD%",
        "其他攻速%(自訂)",
        "攻速濃縮汁(10%)"
      ]
    },
    "step5_flat_bonus": {
      "description": "直接ASPD加值",
      "formula": "FinalASPD = AfterEquip + FlatASPD + MagicPerfume",
      "flat_sources": [
        "裝備直接+ASPD數值 (-20 ~ +20)",
        "魔幻香水 (+1)"
      ]
    },
    "step6_attack_frequency": {
      "formula": "AttacksPerSec = 50 / (200 - FinalASPD)",
      "example": "ASPD 190 → 5 下/秒, ASPD 193 → 7.14 下/秒"
    }
  },
  "variables_explanation": {
    "AGI": "素質AGI總和（含職業加成/技能/JOB加成）",
    "DEX": "素質DEX總和（含職業加成/技能/JOB加成）",
    "WeaponValue": "右手武器基礎攻速值（依職業&武器而定，如空手=154, 弓=144）",
    "ShieldValue": "左手盾牌值（空手=0, 盾牌=-1~-10）或雙持武器值",
    "SkillPotionPercent": "技能攻速%(速度激發等) + 攻速藥水%",
    "EquipPercent": "裝備ASPD% + 其他攻速%(自訂) + 攻速濃縮汁(10%)",
    "FlatASPD": "裝備直接+ASPD數值（-20~+20）",
    "RuneLevel": "Asir盧恩石等級（1~10），僅盧恩騎士可用"
  },
  "potion_values": {
    "集中藥水": 10,
    "覺醒藥水": 15,
    "菠色克藥水(一般)": 20,
    "菠色克藥水(投擲)": 20,
    "毒藥瓶": 20,
    "瓜拿那糖果": 10,
    "攻速濃縮汁": 10,
    "魔幻香水": "直接+1 ASPD"
  },
  "aspd_cap": {
    "等級 < 100": {
      "max_ASPD": 190,
      "max_attacks_per_sec": 5.0
    },
    "等級 >= 100": {
      "max_ASPD": 193,
      "max_attacks_per_sec": 7.14
    }
  },
  "calculation_example": {
    "scenario": "盧恩騎士, Lv200, AGI=120, DEX=30, 空手(RH=154), 無盾, 無技能/藥水/裝備",
    "step1": "StatBonus = sqrt(120 * 1120/111 + 30 * 11/60) = sqrt(1210.81 + 5.5) = sqrt(1216.31) ≈ 34.87",
    "step2": "BaseTemp = 154 + 34.87 * (1 - (154-144)/50) + 0 = 154 + 34.87 * 0.8 = 154 + 27.90 = 181.90",
    "step3": "AfterSkill = 200 - (200 - 181.90) * 100/100 = 200 - 18.10 = 181.90",
    "step4": "AfterEquip = 200 - (200 - 181.90) * 100/100 = 181.90",
    "step5": "FinalASPD = 181.90 + 0 + 0 = 181.90（約181.9）",
    "step6": "攻速 = 50 / (200 - 181.9) = 50 / 18.1 ≈ 2.76 下/秒"
  }
}